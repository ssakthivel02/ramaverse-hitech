# RamaVerse Website provider-neutral deployment template
# No values in this file are real secrets.

PORT=3000
DATABASE_URL=mysql://user:password@localhost:3306/ramaverse
JWT_SECRET=replace-with-a-random-32-byte-secret

# Optional native object storage for future uploads; public V1 does not require it.
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=ramaverse
# S3_ACCESS_KEY_ID=replace-me
# S3_SECRET_ACCESS_KEY=replace-me

# Optional external AI adapter; local grounded Ask remains the default.
# OPTIONAL_AI_API_BASE_URL=https://ai.example.com/v1
# OPTIONAL_AI_API_KEY=replace-me

VITE_APP_TITLE=RamaVerse — Sacred Ramayana Platform
VITE_APP_LOGO=/logo.png

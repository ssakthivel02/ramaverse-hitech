# Core server
NODE_ENV=development
VITE_APP_ID=ramaverse
JWT_SECRET=replace-with-a-long-random-secret

# MySQL runtime. For Aiven preview, use database ramaverse_preview and
# provide the Aiven project CA certificate as base64. Never commit real values.
DATABASE_URL=
DATABASE_EXPECTED_NAME=ramaverse_preview
DATABASE_CA_CERT_B64=
OWNER_OPEN_ID=

# Optional provider-neutral OpenID Connect authentication.
# Public Reader access does not require identity.
VITE_OIDC_AUTHORIZATION_URL=
VITE_OIDC_CLIENT_ID=ramaverse
VITE_OIDC_SCOPES=openid profile email
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_CLIENT_ID=ramaverse
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_PROVIDER_NAME=oidc

# Optional provider-neutral OpenAI-compatible intelligence runtime.
# Canonical Reader/corpus data access remains database-backed and does not
# require this unless an intelligence feature invokes the LLM adapter.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
